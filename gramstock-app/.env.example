# ==============================================================================
# GramStock Cloud — Environment Configuration
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Database (PostgreSQL required for production multi-tenant schema)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gramstock?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Session Secret (Generate via: openssl rand -base64 32)
AUTH_SECRET="dev-insecure-secret-key-change-in-production-gramstock-2026"

# Storage Adapter: "local" (default dev) or "s3" (production)
STORAGE_ADAPTER="local"
UPLOAD_DIR="./uploads"

# AWS Configuration (Only required when STORAGE_ADAPTER=s3)
# Leave empty for local development
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# CloudWatch & Monitoring Telemetry (Optional)
CLOUDWATCH_ENABLED="false"
CLOUDWATCH_NAMESPACE="GramStock/Production"
