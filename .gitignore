# ==============================================================================
# GramStock Cloud — Git Ignore Configuration
# ==============================================================================

# Environment files (CRITICAL: Never push secrets to GitHub)
.env
.env*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local storage and dev database state
.data/
uploads/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Dependencies
node_modules/
/.pnp
.pnp.*

# Next.js build outputs
.next/
out/
build/
dist/

# TypeScript & IDE
*.tsbuildinfo
next-env.d.ts
.vercel/
.idea/
.vscode/
*.swp
*.swo

# Temporary & Lock files (e.g. PowerPoint open temp files)
~$*
*.tmp

# Presentations & Presentation Generator Scripts (Kept local, excluded from GitHub)
*.pptx
*.py
START_HERE_MASTER_PROMPT.txt
project_struct.txt
IMPLEMENTATION_PLAN.md
PRESENTATION_SPEAKING_GUIDE.md
VIVA_3_MINUTE_WALKTHROUGH.md

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
